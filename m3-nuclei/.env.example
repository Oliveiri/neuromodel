# -----------------------------
# Image and container
# -----------------------------
M3_IMAGE_NAME=m3-seg
M3_IMAGE_TAG=latest
M3_CONTAINER_NAME=m3-seg

# -----------------------------
# Service port mapping
# host:container
# -----------------------------
M3_PORT=5004

# -----------------------------
# Docker network (custom bridge)
# -----------------------------
M3_DOCKER_NETWORK_NAME=m3_infer_net
M3_DOCKER_SUBNET=172.29.0.0/24
M3_DOCKER_GATEWAY=172.29.0.1
M3_IPV4_ADDRESS=172.29.0.10

# -----------------------------
# Runtime tuning
# -----------------------------
M3_MAX_BATCH_SIZE=64
M3_MAX_INFLIGHT_PER_REQUEST=8
M3_GLOBAL_MAX_INFLIGHT=32
M3_SEGMENT_TIMEOUT_SEC=120

# turing_segment infer args
M3_MODEL_TYPE=he2
M3_CHANNELS=0,1,2
M3_IMAGE_TYPE=cv2

# -----------------------------
# Package source for turing_segment
# Leave blank if public source is available.
# Fill these when algorithm team provides private index.
# -----------------------------
TURING_SEGMENT_PKG=turing_segment
TURING_SEGMENT_PIP_INDEX_URL=
TURING_SEGMENT_PIP_EXTRA_INDEX_URL=

# Optional timezone
TZ=Asia/Shanghai
